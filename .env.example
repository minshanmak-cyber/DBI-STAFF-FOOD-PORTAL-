# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Secret key for encrypting/signing HTTP-only session cookies (minimum 32 characters)
SESSION_SECRET="your-super-secret-key-at-least-32-characters-long"

# Timezone configuration (Asia/Kolkata for IST)
APP_TIMEZONE="Asia/Kolkata"

# Next.js Port
PORT=3000

# Application environment
NODE_ENV="production"

